# Environment for the LOCAL n8n process.
#
#   set -a && source .env && set +a && npx n8n start
#
# Keep comments on their own line. Some loaders (docker-compose env_file, and
# `export $(... | xargs)`) do not strip a trailing `# comment` from a value,
# and silently append it to the key.

# aistudio.google.com -> Get API key   (starts with AIza)
GEMINI_API_KEY=

# apify.com -> Settings -> API & Integrations -> Personal API token
# Paid: ~$5/month of platform credit (no permanent free tier)
APIFY_TOKEN=

# The ~44-char id from the Sheet URL, between /d/ and /edit
JOBS_SHEET_ID=

# The ~33-char id from the Drive URL, between /d/ and /view
RESUME_FILE_ID=

# Required, or $env is unreadable inside n8n Code nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
